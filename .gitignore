# Secretos (la plantilla .env.example sí se sube)
.env

# Entornos y cachés de Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Artefactos regenerados por scripts/train_model.py (se comparan con los oficiales, no los sustituyen)
